APP_ENV=production
LOG_LEVEL=INFO
PEDIDOS_URL=http://pedidos:8000
ESTOQUE_URL=http://estoque:8000
PAGAMENTOS_URL=http://pagamentos:8000
HTTP_TIMEOUT_SECONDS=3
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
# 100% dos spans saem do app; a decisão de amostragem é do collector (tail sampling:
# guarda todo erro/lentidão + 10% do resto), algo impossível com amostragem na origem.
OTEL_TRACES_SAMPLER=parentbased_always_on
PAYMENT_PROVIDER_LATENCY_MS=150
PAYMENT_PROVIDER_FAILURE_RATE=0.0
PAYMENT_APPROVAL_LIMIT=5000
