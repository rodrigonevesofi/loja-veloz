# Copie para .env para sobrescrever os defaults de desenvolvimento do docker-compose.yml.
# O arquivo .env está no .gitignore: NUNCA commite credenciais reais.
TAG=dev
REGISTRY=ghcr.io/rodrigonevesofi
LOG_LEVEL=INFO

POSTGRES_PASSWORD=troque-me
PEDIDOS_DB_PASSWORD=troque-me
ESTOQUE_DB_PASSWORD=troque-me
GRAFANA_ADMIN_PASSWORD=troque-me

# Simulação do provedor de pagamento (para demonstrar falhas, alertas e compensação)
PAYMENT_PROVIDER_LATENCY_MS=150
PAYMENT_PROVIDER_FAILURE_RATE=0.02
